{
  "name": "@aiqnet/sdk",
  "version": "2.0.0",
  "description": "QNet developer kit: wallet connection and sign-in for web pages, transaction builders, a node client and the qnet command line",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "qnet": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node build.mjs",
    "check:pin": "node scripts/pin-check.mjs",
    "prepack": "node scripts/pin-check.mjs && node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node build.mjs && node --test --test-concurrency=1 \"test/*.test.mjs\""
  },
  "keywords": [
    "qnet",
    "post-quantum",
    "ml-dsa"
  ],
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@noble/post-quantum": "0.7.1",
    "@scure/base": "2.4.0",
    "@scure/bip39": "2.4.0",
    "hash-wasm": "4.12.0"
  },
  "devDependencies": {
    "@types/node": "20.17.50",
    "esbuild": "0.28.2",
    "js-sha3": "0.9.3",
    "typescript": "5.9.3"
  }
}
