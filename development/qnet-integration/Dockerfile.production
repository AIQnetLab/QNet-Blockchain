# PRODUCTION QNet Node Dockerfile - Ubuntu 22.04 (glibc 2.35)
FROM ubuntu:22.04 AS builder

LABEL maintainer="QNet Development Team"
LABEL description="Production QNet Blockchain Node"
LABEL version="2.0.0"

# Prevent interactive prompts during build
ENV DEBIAN_FRONTEND=noninteractive

# Install build dependencies + Rust
RUN apt-get update && apt-get install -y \
    curl \
    pkg-config \
    libssl-dev \
    libclang-dev \
    zlib1g-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain 1.93.0

ENV PATH="/root/.cargo/bin:${PATH}"

# Set working directory
WORKDIR /build

# Copy workspace from project root (context should be QNet-Project root)
COPY . .

# Build the specific binary with maximum optimization for production
ENV RUSTFLAGS="-C target-cpu=x86-64"
ENV CARGO_NET_GIT_FETCH_WITH_CLI=true
ENV CARGO_HTTP_MULTIPLEXING=false
ENV CARGO_NET_RETRY=10
ENV CARGO_HTTP_TIMEOUT=300

# Build using Cargo.lock for deterministic dependency resolution
RUN cargo build --profile release-fast --bin qnet-node \
    && strip target/release-fast/qnet-node \
    && cp target/release-fast/qnet-node /usr/local/bin/

# Production runtime image — same Ubuntu 22.04 for glibc compatibility
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install minimal runtime dependencies including gosu for user switching
RUN apt-get update && apt-get install -y \
    libssl3 \
    ca-certificates \
    curl \
    gosu \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -r qnet \
    && useradd -r -g qnet -s /bin/false qnet

# Copy binary from builder
COPY --from=builder /usr/local/bin/qnet-node /usr/local/bin/

# Create necessary directories with proper permissions
RUN mkdir -p /app/data /app/logs \
    && chown -R qnet:qnet /app \
    && chmod 755 /app/data /app/logs

# Create entrypoint script that fixes permissions, cleans corrupted DB, and switches user
RUN echo '#!/bin/bash\n\
set -e\n\
DATA_DIR="${QNET_DATA_DIR:-/app/data}"\n\
\n\
# ════════════════════════════════════════════════════════════════════════════\n\
# QNET v2.19.22+ REQUIRED PORTS - MUST BE OPEN IN HOST FIREWALL!\n\
# ════════════════════════════════════════════════════════════════════════════\n\
echo ""\n\
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"\n\
echo "🔌 QNET v2.42.1 - REQUIRED PORTS (must be open on HOST firewall!)"\n\
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"\n\
echo "   TCP 9876  - P2P Network"\n\
echo "   TCP 9877  - Gossip Protocol"\n\
echo "   TCP 8001  - REST API"\n\
echo "   UDP 10876 - QUIC Transport ⚡ (Required for v2.19.22+)"\n\
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"\n\
echo "⚠️  RUN ON HOST: sudo ufw allow 9876,9877,8001/tcp && sudo ufw allow 10876/udp"\n\
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"\n\
echo ""\n\
set +e\n\
echo "🕐 Checking host time synchronization..."\n\
LOCAL_TIME=$(date +%s)\n\
NTP_SYNCED=$(timedatectl show 2>/dev/null | grep "NTPSynchronized=yes")\n\
if [ -n "$NTP_SYNCED" ]; then\n\
  echo "   ✅ Host clock synchronized (systemd-timesyncd active)"\n\
else\n\
  REMOTE_TIME=$(curl -s --max-time 5 http://time.google.com/gtimes 2>/dev/null | grep -o "[0-9]\{10\}" | head -1)\n\
  if [ -n "$REMOTE_TIME" ] && [ "$REMOTE_TIME" != "0" ]; then\n\
    DRIFT=$((LOCAL_TIME > REMOTE_TIME ? LOCAL_TIME - REMOTE_TIME : REMOTE_TIME - LOCAL_TIME))\n\
    if [ "$DRIFT" -gt 30 ]; then\n\
      echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"\n\
      echo "🚨 CRITICAL: HOST CLOCK DRIFT = ${DRIFT} SECONDS!"\n\
      echo "   Block timestamps will be wrong. Network may stall!"\n\
      echo "   FIX ON HOST: sudo apt install chrony && sudo systemctl enable --now chrony"\n\
      echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"\n\
    else\n\
      echo "   ✅ Host clock synchronized (drift: ${DRIFT}s)"\n\
    fi\n\
  else\n\
    echo "   ✅ NTP status: host daemon active (timedatectl unavailable in container)"\n\
  fi\n\
fi\n\
echo ""\n\
set -e\n\
\n\
if [ "$(id -u)" = "0" ]; then\n\
  echo "Checking data directory: $DATA_DIR"\n\
  \n\
  # v8.1: Remove stale LOCK file left by unclean shutdown (docker stop → SIGKILL).\n\
  # RocksDB recreates LOCK on open — safe to remove before startup.\n\
  rm -f "$DATA_DIR/LOCK"\n\
  \n\
  # RocksDB integrity: a valid store has BOTH a MANIFEST-* and CURRENT. The old\n\
  # [ ! -f "$MANIFEST_FILE" ] test was dead (a matched glob always exists). Conservative:\n\
  # wipe ONLY when DB files exist but MANIFEST/CURRENT is missing (genuine FS corruption);\n\
  # a healthy DB always has both, so this never wipes a good store.\n\
  if [ -d "$DATA_DIR" ] && [ "$(ls -A "$DATA_DIR" 2>/dev/null)" ]; then\n\
    if ls "$DATA_DIR"/MANIFEST-* >/dev/null 2>&1 && [ -f "$DATA_DIR/CURRENT" ]; then\n\
      echo "RocksDB healthy"\n\
    elif ls "$DATA_DIR"/*.sst >/dev/null 2>&1 || ls "$DATA_DIR"/MANIFEST-* >/dev/null 2>&1; then\n\
      echo "Corrupted RocksDB (MANIFEST/CURRENT missing) - cleaning for fresh start"\n\
      rm -rf "$DATA_DIR"/*\n\
    else\n\
      echo "No RocksDB present - starting fresh"\n\
    fi\n\
  else\n\
    echo "🆕 Creating new data directory"\n\
    mkdir -p "$DATA_DIR"\n\
  fi\n\
  \n\
  echo "Fixing data directory permissions..."\n\
  chown -R qnet:qnet "$DATA_DIR"\n\
  chmod -R 755 "$DATA_DIR"\n\
  echo "Starting QNet node as qnet user..."\n\
  exec gosu qnet /usr/local/bin/qnet-node "$@"\n\
else\n\
  exec /usr/local/bin/qnet-node "$@"\n\
fi' > /usr/local/bin/entrypoint.sh \
    && chmod +x /usr/local/bin/entrypoint.sh

# Keep as root to allow permission fixes
USER root

# Set environment variables for production
ENV RUST_LOG=info
ENV RUST_BACKTRACE=1
ENV QNET_DATA_DIR=/app/data
ENV QNET_LOG_DIR=/app/logs

# Health check for production monitoring
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8001/api/v1/node/health || exit 1

# Expose required ports (QNet specific)
# 9876 - P2P HTTP
# 9877 - P2P gossip
# 8001 - REST API
# 10876 - QUIC transport (9876 + 1000)
EXPOSE 9876 9877 8001 10876

# Production startup command with automatic permission fixing
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD [] 