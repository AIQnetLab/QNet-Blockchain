<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications: required for FCM silent pushes to wake the app in background/killed state -->
	<key>aps-environment</key>
	<string>production</string>
	<!-- Keychain Sharing: allows react-native-keychain to use the default keychain group -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.qnet.mobile</string>
	</array>
</dict>
</plist>
