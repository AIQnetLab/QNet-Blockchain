<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>QNet Wallet</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Standard algorithms (ML-DSA-65 and SHA-3 in the app's own native module, PBKDF2 and AES-256-GCM in its bundled
	     crypto library, X25519/HKDF/AES-256-GCM and Ed25519 in its JS crypto libraries), not taken from the OS. App Store
	     Connect's encryption questionnaire, answered "standard algorithms" and "not available in France", requires no
	     export compliance documentation and has that declared here as NO; a YES build is refused at upload without the
	     ITSEncryptionExportComplianceCode of approved documentation. Offering the app in France takes the French
	     encryption declaration first, then YES with that code (store-listing/README.md). -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- HTTPS only, no exceptions: every host the app talks to serves TLS, and node URLs that are not https are
	     dropped before any request (src/config/nodes.js). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>
	<!-- The vault and every other AsyncStorage file stay out of iCloud and computer backups (also the
	     library default; pinned here so an upgrade cannot change it). Keychain items are ThisDeviceOnly. -->
	<key>RCTAsyncStorageExcludeFromBackup</key>
	<true/>
	<!-- The eleven languages of the app (src/i18n): iOS offers them in Settings, the App Store lists them, and the
	     purpose strings come in each (<lang>.lproj/InfoPlist.strings). The same list on every device (SD-R3-02). -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh-Hans</string>
		<string>ru</string>
		<string>es</string>
		<string>ko</string>
		<string>ja</string>
		<string>pt</string>
		<string>fr</string>
		<string>de</string>
		<string>ar</string>
		<string>it</string>
	</array>
	<key>NSFaceIDUsageDescription</key>
	<string>QNet Wallet uses Face ID to securely unlock your wallet and authorize transactions</string>
	<!-- The camera is for the QR scan on the Send screens (QNet and Solana) only, asked for when the scan icon is tapped. Web pages in
	     the in-app browser get no camera (the WebView patch denies them). -->
	<key>NSCameraUsageDescription</key>
	<string>QNet Wallet uses the camera only to scan an address from a QR code when you tap the scan icon on the Send screen.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>fetch</string>
	</array>
	<!-- Only the periodic wake (a background refresh task, requested again at every return to the app): iOS schedules no
	     other task for the app (the precise one-shot wakes are Android's). -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.transistorsoft.fetch</string>
	</array>
	<!-- Same architecture as the Android build (newArchEnabled=false): the native modules were validated there. -->
	<key>RCTNewArchEnabled</key>
	<false/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- iPad: every orientation and no full-screen requirement, so Split View, Slide Over and Stage Manager work. -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
