+// QNet (MPLAT-R3-01): the recovery-phrase field (testID "qnet-seed-input", which React Native sets as this view's
+// accessibilityIdentifier) keeps Paste and selection only. Nothing that exports its text is offered (Copy, Cut,
+// Share, Look Up, Translate and the rest of the edit menu). The pasteboard is not cleared here: since iOS 16 a paste
+// reads it asynchronously, so clearing it at once lost the text; the screen clears it once the phrase has landed
+// (WalletScreen onSeedPhraseChange).
+static BOOL RCTQNetIsSeedField(UIView *view)
+{
+  return [view.accessibilityIdentifier isEqualToString:@"qnet-seed-input"];
+}
+
 - (instancetype)initWithFrame:(CGRect)frame
