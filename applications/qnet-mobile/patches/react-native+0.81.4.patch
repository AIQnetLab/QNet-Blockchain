+#pragma mark - QNet: liveness of the open sockets
+
+- (void)qnetStartPinging
+{
+  if (_pingTimer) {
+    return;
+  }
+  __weak RCTWebSocketModule *weakSelf = self;
+  _pingTimer = [NSTimer timerWithTimeInterval:RCTQNetPingInterval
+                                      repeats:YES
+                                        block:^(__unused NSTimer *timer) {
+                                          [weakSelf qnetPingOpenSockets];
+                                        }];
+  [[NSRunLoop mainRunLoop] addTimer:_pingTimer forMode:NSRunLoopCommonModes];
+}
+
+// A socket still waiting for the pong of the ping before fails as one that failed by itself; every other open one is
+// pinged. The timer stops once no socket is left.
+- (void)qnetPingOpenSockets
+{
+  if (!_awaitingPong) {
+    _awaitingPong = [NSMutableSet new];
+  }
+  [_awaitingPong intersectSet:[NSSet setWithArray:_sockets.allKeys ?: @[]]];
+  for (NSNumber *socketID in _sockets.allKeys) {
+    SRWebSocket *socket = _sockets[socketID];
+    if (socket.readyState != SR_OPEN) {
+      continue;
+    }
+    if ([_awaitingPong containsObject:socketID]) {
+      [_awaitingPong removeObject:socketID];
+      socket.delegate = nil;
+      [socket close];
+      NSError *silent = [NSError errorWithDomain:@"RCTWebSocketModule"
+                                            code:0
+                                        userInfo:@{NSLocalizedDescriptionKey : @"sent ping but didn't receive pong"}];
+      [self webSocket:socket didFailWithError:silent];
+      continue;
+    }
+    [_awaitingPong addObject:socketID];
+    [socket sendPing:nil error:nil];
+  }
+  if (_sockets.count == 0) {
+    [_pingTimer invalidate];
+    _pingTimer = nil;
+  }
+}
+
+- (void)webSocket:(SRWebSocket *)webSocket didReceivePong:(NSData *)pongData
+{
+  [_awaitingPong removeObject:webSocket.reactTag];
+}
