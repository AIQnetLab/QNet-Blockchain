+// QNet: every open socket is pinged this often (AppNetwork.PING_MS on Android); one whose ping got no pong by the next
+// fails, as OkHttp fails it on Android, so a socket gone silent (a VPN turned off) ends and its JS opens a new one.
+static const NSTimeInterval RCTQNetPingInterval = 15;
+
 @implementation RCTWebSocketModule {
   NSMutableDictionary<NSNumber *, SRWebSocket *> *_sockets;
