+{
+  if (RCTQNetIsSeedField(self)) {
+    return;
+  }
+  [super copy:sender];
+}
+
+- (void)cut:(id)sender
+{
+  if (RCTQNetIsSeedField(self)) {
+    return;
+  }
+  [super cut:sender];
+}
