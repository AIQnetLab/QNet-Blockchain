{
  "name": "qnet-explorer-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "QNet Blockchain Explorer - Next.js Frontend with Quantum UI",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "dev:turbo": "next dev -H 0.0.0.0 --turbopack",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "bunx biome lint --write && bunx tsc --noEmit",
    "format": "bunx biome format --write",
    "db:migrate": "node -r ts-node/register scripts/run-migrations.ts",
    "start:local": "bash scripts/start-local.sh",
    "build:indexer": "tsc -p tsconfig.indexer.json",
    "start:indexer": "node dist-indexer/main.js",
    "test:indexer": "tsc -p tsconfig.indexer.json && node --test \"dist-indexer/__tests__/*.test.js\"",
    "test:wallet": "node --experimental-strip-types --test \"src/lib/__tests__/*.test.mjs\"",
    "check:release": "node --experimental-strip-types --test \"src/lib/__release__/*.test.mjs\"",
    "audit:check": "node scripts/audit-check.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@noble/curves": "1.9.2",
    "@noble/hashes": "1.8.0",
    "@noble/post-quantum": "0.7.1",
    "@radix-ui/react-dialog": "1.1.13",
    "@radix-ui/react-dropdown-menu": "2.1.14",
    "@radix-ui/react-label": "2.1.6",
    "@radix-ui/react-slot": "1.2.2",
    "@radix-ui/react-tabs": "1.1.11",
    "autoprefixer": "^10.4.21",
    "bs58": "^6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "js-sha3": "^0.9.3",
    "lucide-react": "0.475.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "pg": "8.16.3",
    "postcss-selector-parser": "^7.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "3.0.1",
    "tailwindcss-animate": "1.0.7",
    "tweetnacl": "^1.0.3",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@eslint/eslintrc": "^3",
    "@swc/helpers": "0.5.15",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/react-window": "1.8.8",
    "@types/ws": "^8.5.10",
    "eslint": "^9",
    "eslint-config-next": "15.1.7",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}
