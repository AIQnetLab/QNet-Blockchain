{
  "name": "qnet-wallet",
  "version": "3.1.0",
  "description": "QNet Wallet browser extension: post-quantum (ML-DSA-65) QNet wallet with the Solana account that activates nodes",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bundle:install": "npm ci --prefix tools/crypto-bundle",
    "build": "npm run build --prefix tools/crypto-bundle",
    "build:dev": "node scripts/build-dev.mjs",
    "package": "node scripts/package.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "test:live": "node --test \"test/live/*.test.mjs\"",
    "check:overflow": "node scripts/overflow-check.mjs"
  }
}
