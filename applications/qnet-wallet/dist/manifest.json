{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "3.1.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "111",
  "homepage_url": "https://aiqnet.io",
  "permissions": [
    "storage",
    "alarms",
    "idle"
  ],
  "host_permissions": [
    "https://node1.aiqnet.io/*",
    "https://node2.aiqnet.io/*",
    "https://node3.aiqnet.io/*",
    "https://node4.aiqnet.io/*",
    "https://node5.aiqnet.io/*",
    "https://aiqnet.io/*",
    "https://api.devnet.solana.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data:; connect-src 'self' https://node1.aiqnet.io https://node2.aiqnet.io https://node3.aiqnet.io https://node4.aiqnet.io https://node5.aiqnet.io https://aiqnet.io https://api.devnet.solana.com; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
  },
  "background": {
    "service_worker": "background/sw.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://aiqnet.io/*",
        "https://games.aiqnet.io/*"
      ],
      "js": [
        "inject/provider.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://aiqnet.io/*",
        "https://games.aiqnet.io/*"
      ],
      "js": [
        "content/relay.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
